{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "src/vite-env.d.ts",
